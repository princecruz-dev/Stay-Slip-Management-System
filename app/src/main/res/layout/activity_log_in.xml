<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundmcs">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="0dp"
        android:layout_height="195dp"
        android:layout_marginTop="21dp"
        android:contentDescription="@string/school_logo"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.80" />

    <TextView
        android:id="@+id/schoolName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="8dp"
        android:elevation="10dp"
        android:gravity="center"
        android:shadowColor="#777777"
        android:shadowDx="1"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:text="@string/mcs_title"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView2" />

    <LinearLayout
        android:id="@+id/bluePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bluebg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="5dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/schoolName"
        app:layout_constraintVertical_bias="0.0">

        <TextView
            android:id="@+id/selectUserType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center_vertical"
            android:shadowColor="#777777"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="@string/select_user_type"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/studentbtn"
            android:layout_width="419dp"
            android:layout_height="89dp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/studentbtn"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/studentbtn" />


        <ImageButton
            android:id="@+id/teacherbtn"
            android:layout_width="332dp"
            android:layout_height="87dp"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/teacherbtn"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/teacherbtn" />

        <ImageButton
            android:id="@+id/sbmobtn1"
            android:layout_width="345dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:contentDescription="@string/sbmobtn"
            android:padding="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sbmobtn1" />

        <ImageView
            android:id="@+id/schoolBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/school_building"
            android:scaleType="centerCrop"
            android:src="@drawable/backgroundmcs" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
