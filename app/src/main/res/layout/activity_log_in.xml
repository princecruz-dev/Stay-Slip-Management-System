<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/schoolBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/backgroundmcs"
        android:scaleType="centerCrop"
        android:contentDescription="School building"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/schoolName"
        android:layout_width="363dp"
        android:layout_height="33dp"
        android:layout_marginTop="216dp"
        android:elevation="10dp"
        android:shadowColor="#777777"
        android:shadowDx="1"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:text="@string/mcs_title"
        android:textColor="#000000"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/bluePanel"
        android:layout_width="412dp"
        android:layout_height="480dp"
        android:layout_marginTop="195dp"
        android:background="@drawable/blue_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="5dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <TextView
            android:id="@+id/selectUserType"
            android:layout_width="366dp"
            android:layout_height="57dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-condensed"
            android:shadowColor="#777777"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:text="@string/select_user_type"
            android:textColor="#FFFFFF"
            android:textSize="39sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/studentBtn"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/white_round_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="82dp"
                android:layout_height="69dp"
                android:layout_gravity="start|bottom"
                android:contentDescription="Student character"
                android:scaleType="fitCenter"
                android:src="@drawable/student" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="@string/student"
                android:textColor="#03A9F4"
                android:textSize="32sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/teacherBtn"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/white_round_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="73dp"
                android:layout_gravity="start|bottom"
                android:contentDescription="Teacher character"
                android:scaleType="fitCenter"
                android:src="@drawable/teacher" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="@string/teacher"
                android:textColor="#03A9F4"
                android:textSize="32sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/sbmoBtn"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:background="@drawable/white_round_button"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="85dp"
                android:layout_height="74dp"
                android:layout_gravity="start|bottom"
                android:contentDescription="SBMO character"
                android:scaleType="fitCenter"
                android:src="@drawable/sbmo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:text="@string/sbmo"
                android:textColor="#03A9F4"
                android:textSize="32sp"
                android:textStyle="bold" />

        </FrameLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="319dp"
        android:layout_height="195dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="Manila Cathedral School Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="21dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>
