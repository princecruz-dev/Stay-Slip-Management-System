<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:id="@+id/SBMOapproval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/sbmo_approval"
            android:textColor="#1558B0"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stay_slip_request"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/review_the_request_details_below"
            android:textColor="#546E7A"
            android:textSize="14sp" />

        <!-- REQUEST DETAILS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/txtReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reason_medical_appointment"
                android:textSize="16sp"
                android:textColor="#172B4D"
                android:padding="6dp" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_apr_23_2025"
                android:textSize="16sp"
                android:textColor="#172B4D"
                android:padding="6dp" />

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/time_10_00_am"
                android:textSize="16sp"
                android:textColor="#172B4D"
                android:padding="6dp" />

        </LinearLayout>

        <!-- APPROVE BUTTON -->
        <Button
            android:id="@+id/btnApprove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/approve"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#16A34A"
            android:layout_marginTop="20dp" />

        <!-- REJECT BUTTON -->
        <Button
            android:id="@+id/btnReject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reject"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#DC2626"
            android:layout_marginTop="8dp" />

        <!-- REMARKS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remarks_optional"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/etRemarks"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:autofillHints=""
            android:hint="@string/enter_remarks"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="12dp"
            android:backgroundTint="#9CAFCB" />

        <!-- NOTIFICATION SWITCH -->

        <!-- STATUS -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:minHeight="48dp"
            android:padding="8dp"
            android:text="@string/notify_student"
            android:textColor="#172B4D"
            android:textSize="16sp"
            app:showText="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/current_status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#172B4D"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF3CD"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/status_pending"
            android:textColor="#E65100"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
